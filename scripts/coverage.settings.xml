<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*PDF Converter\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*PdfConverter\.Tests\.(dll|exe)$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <Source>.*\.Designer\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
