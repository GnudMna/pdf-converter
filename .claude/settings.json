{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(./src/PdfConverter.Tests/bin/*/*/PdfConverter.Tests.exe:*)",
      "PowerShell(dotnet restore:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(./scripts/build-and-test.ps1:*)",
      "PowerShell(.\\scripts\\build-and-test.ps1:*)",
      "PowerShell(./src/PdfConverter.Tests/bin/*/*/PdfConverter.Tests.exe:*)",
      "PowerShell(.\\src\\PdfConverter.Tests\\bin\\*\\*\\PdfConverter.Tests.exe:*)",
      "PowerShell(./scripts/format.ps1:*)",
      "PowerShell(.\\scripts\\format.ps1:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet tool restore)",
      "PowerShell(dotnet format:*)",
      "PowerShell(dotnet tool restore)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git branch -r)",
      "Bash(git switch -c:*)",
      "Bash(git branch -m:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git worktree list)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch -vv)",
      "PowerShell(git branch -r)",
      "PowerShell(git switch -c:*)",
      "PowerShell(git branch -m:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.env)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.env)",
      "Bash(cat .env*)",
      "PowerShell(Get-Content .env*)",
      "Edit(docs/user/changelog.md)",
      "Write(docs/user/changelog.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/format-cs.ps1\"",
            "timeout": 60,
            "statusMessage": "C# の書式を整えています..."
          }
        ]
      }
    ]
  }
}
