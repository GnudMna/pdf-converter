{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(./src/PdfConverter.Tests/bin/*/*/net10.0-windows/PdfConverter.Tests.exe:*)",
      "PowerShell(dotnet restore:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(./installer/build-and-test.ps1:*)",
      "PowerShell(.\\installer\\build-and-test.ps1:*)",
      "PowerShell(./src/PdfConverter.Tests/bin/*/*/net10.0-windows/PdfConverter.Tests.exe:*)",
      "PowerShell(.\\src\\PdfConverter.Tests\\bin\\*\\*\\net10.0-windows\\PdfConverter.Tests.exe:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git branch -r)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git worktree list)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch -vv)",
      "PowerShell(git branch -r)"
    ],
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.env)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.env)",
      "Bash(cat .env*)",
      "PowerShell(Get-Content .env*)",
      "Read(**/UpdateReleaseKey.local.props)",
      "Edit(**/UpdateReleaseKey.local.props)",
      "Write(**/UpdateReleaseKey.local.props)",
      "Edit(docs/user/changelog.md)",
      "Write(docs/user/changelog.md)"
    ]
  }
}
