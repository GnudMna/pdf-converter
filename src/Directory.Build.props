<Project>
  <!--
    バージョン等は各プロジェクトの Properties/AssemblyInfo.cs で管理する。
    SDK の自動生成は AssemblyInfo.cs と重複する属性のみ無効化し、
    TargetPlatform / SupportedOSPlatform 属性 (CA1416 判定に必要) は生成させる。
  -->
  <PropertyGroup>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyTrademarkAttribute>false</GenerateAssemblyTrademarkAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
  </PropertyGroup>

  <!--
    全プロジェクト共通のビルド設定。
    pdfium.dll がプラットフォーム固有のため x64 / x86 のみ対応し、出力先は bin\<Platform>\<Configuration>\ に揃える (ターゲットフレームワーク名のフォルダーは付けない)。
    Release の DebugType はプロジェクトごとに異なるため各 csproj で指定する。
  -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Platforms>x64;x86</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <!--
    依存パッケージのロック。推移的な依存も packages.lock.json に固定し、復元のたびに解決し直されないようにする。
    Platform ごとに RuntimeIdentifier が変わるため、両方の RID をまとめて復元し、x64 / x86 のどちらで復元してもロックファイルが同じになるようにする。
    ロックファイルと食い違う復元は、scripts/build-and-test.ps1 と scripts/build-installer.ps1 が locked mode で検出する。
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
  </PropertyGroup>
  <!--
    コード解析。CI がないため、警告をエラーにしてローカルビルドで必ず検出する。
    SDK 更新でルールが増えてビルドが壊れないよう、解析レベルは SDK のバージョンに固定する。
    個別ルールの抑止・オプションは .editorconfig で指定する。
    NuGet の脆弱性監査 (NU1901-NU1904) は、新しい勧告の公開だけでビルドが止まらないよう警告のままにする。
  -->
  <PropertyGroup>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
