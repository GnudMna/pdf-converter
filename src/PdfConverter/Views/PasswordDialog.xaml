<Window x:Class="PdfConverter.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="パスワードの入力"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}"
        AutomationProperties.Name="パスワードの入力">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.22" ShadowDepth="4" Direction="270" Color="#FF1E293B" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SectionTitleForegroundBrush}" />
            <TextBlock x:Name="MessageText"
                       Margin="0,8,0,16"
                       TextWrapping="Wrap"
                       MaxWidth="400"
                       LineHeight="20"
                       Foreground="{DynamicResource ControlForegroundBrush}"
                       AutomationProperties.LiveSetting="Polite" />

            <PasswordBox x:Name="PasswordInput"
                         AutomationProperties.Name="パスワード" />

            <StackPanel Margin="0,20,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="キャンセル"
                        MinWidth="100"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}" />
                <Button Content="開く"
                        MinWidth="100"
                        IsDefault="True"
                        Click="OkButton_Click"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
