<Window x:Class="PdfConverter.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報"
        Width="520"
        SizeToContent="Height"
        MinHeight="420"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        AutomationProperties.Name="バージョン情報"
        AutomationProperties.HelpText="アプリのバージョンとオープンソースライセンス">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.22" ShadowDepth="4" Direction="270" Color="#FF1E293B" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,18">
                <Border Width="48"
                        Height="48"
                        CornerRadius="12"
                        Background="{DynamicResource PreviewAreaBackgroundBrush}"
                        BorderBrush="{DynamicResource PreviewAreaBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        Focusable="False"
                        IsHitTestVisible="False">
                    <Image Source="/Assets/app-icon.png"
                           Width="32"
                           Height="32"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ProductNameText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SectionTitleForegroundBrush}" />
                    <TextBlock x:Name="VersionText"
                               Margin="0,4,0,0"
                               Style="{StaticResource HintText}" />
                    <TextBlock x:Name="CopyrightText"
                               Margin="0,2,0,0"
                               Style="{StaticResource HintText}" />
                    <TextBlock x:Name="LicenseText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource ControlForegroundBrush}" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,20"
                          AutomationProperties.Name="ライセンス情報">
                <StackPanel>
                    <TextBlock Text="同梱オープンソース"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="BundledComponentsText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               LineHeight="20"
                               Foreground="{DynamicResource ControlForegroundBrush}" />

                    <TextBlock Text="外部ソフトウェア"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,16,0,8" />
                    <TextBlock x:Name="ExternalDependenciesText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               LineHeight="20"
                               Foreground="{DynamicResource MutedForegroundBrush}" />

                    <TextBlock x:Name="NoticesHintText"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               FontSize="11"
                               LineHeight="17"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <TextBlock x:Name="UpdateStatusText"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           MaxWidth="220"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CheckUpdateButton"
                            Content="更新を確認"
                            MinWidth="110"
                            Margin="0,0,10,0"
                            Click="CheckUpdateButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="更新を確認" />
                    <Button x:Name="OpenNoticesButton"
                            Content="ライセンス全文を開く"
                            MinWidth="140"
                            Margin="0,0,10,0"
                            Click="OpenNoticesButton_Click"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Content="閉じる"
                            MinWidth="100"
                            Click="CloseButton_Click"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
