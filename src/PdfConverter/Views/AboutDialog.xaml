<Window x:Class="PdfConverter.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報"
        Width="600"
        SizeToContent="Height"
        MinHeight="420"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        AutomationProperties.Name="バージョン情報"
        AutomationProperties.HelpText="アプリのバージョンとオープンソースライセンス">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.22" ShadowDepth="4" Direction="270" Color="#FF1E293B" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        CornerRadius="12"
                        Background="{DynamicResource PreviewAreaBackgroundBrush}"
                        BorderBrush="{DynamicResource PreviewAreaBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Top"
                        Focusable="False"
                        IsHitTestVisible="False">
                    <Image Source="/Assets/app-icon.png"
                           Width="32"
                           Height="32"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ProductNameText"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SectionTitleForegroundBrush}" />
                    <TextBlock x:Name="VersionText"
                               Margin="0,4,0,0"
                               Style="{StaticResource HintText}" />
                    <TextBlock x:Name="CopyrightText"
                               Margin="0,2,0,0"
                               Style="{StaticResource HintText}" />
                    <TextBlock x:Name="LicenseText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource ControlForegroundBrush}" />
                    <Button x:Name="OpenLicenseButton"
                            Content="使用許諾を開く"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Click="OpenLicenseButton_Click"
                            Style="{StaticResource CompactToolbarButton}"
                            ToolTip="本アプリの使用許諾 (LICENSE.txt) を開きます。"
                            AutomationProperties.Name="使用許諾を開く"
                            AutomationProperties.HelpText="本アプリの使用許諾 (LICENSE.txt) を開きます。" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,20"
                          AutomationProperties.Name="ライセンス情報">
                <StackPanel>
                    <TextBlock Text="同梱オープンソース"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="BundledComponentsText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               LineHeight="20"
                               Foreground="{DynamicResource ControlForegroundBrush}" />

                    <TextBlock Text="外部ソフトウェア"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,16,0,8" />
                    <TextBlock x:Name="ExternalDependenciesText"
                               TextWrapping="Wrap"
                               FontSize="12"
                               LineHeight="20"
                               Foreground="{DynamicResource MutedForegroundBrush}" />

                    <TextBlock x:Name="NoticesHintText"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               FontSize="11"
                               LineHeight="17"
                               Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="UpdateStatusText"
                           Grid.Row="0"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           AutomationProperties.LiveSetting="Polite" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ResetSettingsButton"
                            Grid.Column="0"
                            Content="設定をリセット"
                            MinWidth="120"
                            HorizontalAlignment="Left"
                            Click="ResetSettingsButton_Click"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="テーマ・変換設定など、保存済みのユーザー設定を既定値に戻します。"
                            AutomationProperties.Name="設定をリセット"
                            AutomationProperties.HelpText="テーマ・変換設定など、保存済みのユーザー設定を既定値に戻します。" />
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="CheckUpdateButton"
                                Content="更新を確認"
                                MinWidth="110"
                                Margin="0,0,10,0"
                                Click="CheckUpdateButton_Click"
                                Style="{StaticResource SecondaryButton}"
                                AutomationProperties.Name="更新を確認" />
                        <Button x:Name="OpenNoticesButton"
                                Content="OSS ライセンスを開く"
                                MinWidth="140"
                                Margin="0,0,10,0"
                                Click="OpenNoticesButton_Click"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="同梱しているオープンソース ソフトウェアのライセンス全文 (THIRD-PARTY-NOTICES.txt) を開きます。"
                                AutomationProperties.Name="OSS ライセンスを開く"
                                AutomationProperties.HelpText="同梱しているオープンソース ソフトウェアのライセンス全文 (THIRD-PARTY-NOTICES.txt) を開きます。" />
                        <Button Content="閉じる"
                                MinWidth="100"
                                Click="CloseButton_Click"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
