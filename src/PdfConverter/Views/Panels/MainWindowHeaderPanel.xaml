<UserControl x:Class="PdfConverter.Views.Panels.MainWindowHeaderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="80"
             d:DesignWidth="760">

    <Border Margin="0,0,0,18"
            Padding="0,0,0,16"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48"
                        Height="48"
                        CornerRadius="12"
                        Background="{DynamicResource PreviewAreaBackgroundBrush}"
                        BorderBrush="{DynamicResource PreviewAreaBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        Focusable="False"
                        IsHitTestVisible="False">
                    <Image Source="/Assets/app-icon.png"
                           Width="32"
                           Height="32"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PDF Converter"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SectionTitleForegroundBrush}" />
                    <TextBlock Text="PDF / Word を画像としてエクスポート"
                               Margin="0,3,0,0"
                               Style="{StaticResource HintText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Command="{Binding ShowAboutCommand}"
                        Style="{StaticResource CompactToolbarButton}"
                        Width="34"
                        Height="28"
                        Padding="0"
                        Margin="0,0,8,0"
                        ToolTip="バージョン情報とオープンソースライセンス"
                        AutomationProperties.Name="バージョン情報"
                        AutomationProperties.HelpText="アプリのバージョンとオープンソースライセンスを表示します">
                    <Path Style="{StaticResource ThemeModeIconPath}"
                          Data="M12 2 A10 10 0 1 0 12 22 A10 10 0 1 0 12 2 M12 10 L12 11 M12 14 L12 16" />
                </Button>

                <Border Style="{StaticResource PreviewToolbarBorder}"
                        ToolTip="外観テーマ"
                        AutomationProperties.Name="外観テーマ">
                    <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ThemeModeRadioButton}"
                                 GroupName="ThemeMode"
                                 DataContext="{Binding Theme}"
                                 IsChecked="{Binding IsLightThemeSelected}"
                                 ToolTip="ライト"
                                 AutomationProperties.Name="ライトテーマ">
                        <Path Style="{StaticResource ThemeModeIconPath}"
                              Data="M12 3.5 L12 6.5 M12 17.5 L12 20.5 M3.5 12 L6.5 12 M17.5 12 L20.5 12 M5.8 5.8 L7.9 7.9 M16.1 16.1 L18.2 18.2 M5.8 18.2 L7.9 16.1 M16.1 7.9 L18.2 5.8 M12 8.5 A3.5 3.5 0 1 0 12 15.5 A3.5 3.5 0 1 0 12 8.5" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ThemeModeRadioButton}"
                                 GroupName="ThemeMode"
                                 DataContext="{Binding Theme}"
                                 Margin="2,0,0,0"
                                 IsChecked="{Binding IsDarkThemeSelected}"
                                 ToolTip="ダーク"
                                 AutomationProperties.Name="ダークテーマ">
                        <Path Style="{StaticResource ThemeModeIconPath}"
                              Data="M15 5.5 A7 7 0 1 1 9 18.5 A5.5 5.5 0 1 0 15 5.5" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ThemeModeRadioButton}"
                                 GroupName="ThemeMode"
                                 DataContext="{Binding Theme}"
                                 Margin="2,0,0,0"
                                 IsChecked="{Binding IsSystemThemeSelected}"
                                 ToolTip="システムに合わせる"
                                 AutomationProperties.Name="システムテーマ">
                        <Path Style="{StaticResource ThemeModeIconPath}"
                              Data="M5 6.5 L19 6.5 L19 15.5 L5 15.5 Z M8 17.5 L16 17.5 M10 17.5 L10 19.5 L14 19.5 L14 17.5" />
                    </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
