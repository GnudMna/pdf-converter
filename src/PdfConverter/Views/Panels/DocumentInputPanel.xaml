<UserControl x:Class="PdfConverter.Views.Panels.DocumentInputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:PdfConverter.Views.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="320">

    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,18">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Rectangle Style="{StaticResource SectionHeaderAccent}" />
                <TextBlock Text="入力情報" Style="{StaticResource SectionTitle}" />
            </StackPanel>
            <StackPanel Margin="0,14,0,0">
                <TextBlock x:Name="FilePathLabel"
                           Text="ファイル (PDF / Word)"
                           Style="{StaticResource FieldLabel}"
                           ToolTip="PDF または Word ファイルのパス。入力後 Enter またはフォーカスを外すと読み込みます。ドラッグ&amp;ドロップでも選択できます。" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding FilePath}"
                             ToolTip="入力後 Enter またはフォーカスを外すと読み込みます"
                             AutomationProperties.LabeledBy="{Binding ElementName=FilePathLabel}"
                             AutomationProperties.HelpText="PDF または Word ファイルのパス。ドラッグ&amp;ドロップでも選択できます"
                             behaviors:InvokeCommandBehavior.LostFocusCommand="{Binding LoadPdfFromPathCommand}"
                             behaviors:InvokeCommandBehavior.EnterKeyCommand="{Binding LoadPdfFromPathCommand}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                             Margin="1,0,12,0" />
                    <Button Grid.Column="1"
                            Content="参照"
                            MinWidth="64"
                            Command="{Binding BrowseCommand}"
                            Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="ファイルを参照"
                            AutomationProperties.HelpText="PDF または Word ファイルを選択します" />
                </Grid>
            </StackPanel>

            <Expander Margin="0,14,0,0"
                      Style="{StaticResource OptionalSectionExpander}"
                      IsExpanded="{Binding WordSettings.IsSectionExpanded}"
                      ToolTip="Word ファイルを開いたときに使用する変換オプションです。"
                      AutomationProperties.Name="Word 設定">
                <Expander.Header>
                    <TextBlock Text="Word 設定"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource FieldLabelForegroundBrush}" />
                </Expander.Header>
                <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                    <TextBlock x:Name="WordBackendLabel"
                               Text="Word → PDF 変換"
                               Style="{StaticResource FieldLabel}"
                               ToolTip="Word ファイルを PDF 化する際に使用するエンジンを選択します。" />
                    <ComboBox Margin="0,8,0,0"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding WordSettings.BackendOptions}"
                              SelectedValue="{Binding WordSettings.Backend}"
                              SelectedValuePath="Backend"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.LabeledBy="{Binding ElementName=WordBackendLabel}" />
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding WordSettings.IsLibreOfficePathVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="LibreOfficePathLabel"
                                   Text="LibreOffice 実行ファイル"
                                   Style="{StaticResource FieldLabel}"
                                   ToolTip="空欄の場合は一般的なインストール先から soffice.exe を自動検出します。入力後 Enter またはフォーカスを外すと反映します。" />
                        <TextBox Margin="0,8,0,0"
                                 Text="{Binding WordSettings.LibreOfficePath}"
                                 ToolTip="入力後 Enter またはフォーカスを外すと反映します"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LibreOfficePathLabel}"
                                 AutomationProperties.HelpText="空欄の場合は一般的なインストール先から soffice.exe を自動検出します"
                                 behaviors:TextBoxBehavior.UpdateSourceOnEnter="True" />
                    </StackPanel>
                    <TextBlock x:Name="PdfFormatLabel"
                               Margin="0,14,0,0"
                               Text="PDF 形式"
                               Style="{StaticResource FieldLabel}"
                               ToolTip="PDF/A-1 は長期保存向けの形式です。" />
                    <ComboBox Margin="0,8,0,0"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding WordSettings.PdfFormatOptions}"
                              SelectedValue="{Binding WordSettings.PdfFormat}"
                              SelectedValuePath="Format"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.LabeledBy="{Binding ElementName=PdfFormatLabel}" />
                    <TextBlock x:Name="OptimizeForLabel"
                               Margin="0,14,0,0"
                               Text="出力最適化"
                               Style="{StaticResource FieldLabel}"
                               ToolTip="オンライン向けはファイルサイズを抑えます。" />
                    <ComboBox Margin="0,8,0,0"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding WordSettings.OptimizeForOptions}"
                              SelectedValue="{Binding WordSettings.OptimizeFor}"
                              SelectedValuePath="OptimizeFor"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.LabeledBy="{Binding ElementName=OptimizeForLabel}" />
                    <CheckBox Margin="0,14,0,0"
                              Content="しおり (見出し) を出力"
                              IsChecked="{Binding WordSettings.ExportBookmarks}"
                              ToolTip="Word 文書の見出しスタイルから PDF のしおりを作成します。" />
                    <CheckBox Margin="0,10,0,0"
                              Content="コメントを含める"
                              IsChecked="{Binding WordSettings.ExportComments}"
                              ToolTip="Word 文書のコメントを PDF に出力します。" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
