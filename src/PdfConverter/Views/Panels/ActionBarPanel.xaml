<UserControl x:Class="PdfConverter.Views.Panels.ActionBarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="48"
             d:DesignWidth="760">

    <Border Margin="0,14,0,0"
            Style="{StaticResource ActionBarBorder}">
        <WrapPanel Orientation="Horizontal"
                   HorizontalAlignment="Left">
            <Button Content="画像として保存"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource SaveButton}"
                    Margin="0,0,10,0" />
            <Button Content="PDF として保存"
                    Margin="0,0,10,0"
                    Command="{Binding SavePdfCommand}"
                    Style="{StaticResource SecondaryButton}"
                    Visibility="{Binding IsSavePdfVisible, Converter={StaticResource BoolToVis}}" />
            <Button Content="プレビューをコピー"
                    Margin="0,0,10,0"
                    Command="{Binding CopyToClipboardCommand}"
                    Style="{StaticResource CopyButton}" />
            <Button Content="キャンセル"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource CancelButton}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </WrapPanel>
    </Border>
</UserControl>
