<UserControl x:Class="PdfConverter.Views.Panels.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:PdfConverter.Views.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="420">

    <Border Style="{StaticResource CardBorder}"
            Padding="18"
            VerticalAlignment="Stretch">
        <Grid VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Style="{StaticResource SectionHeaderAccent}" />
                    <TextBlock Text="プレビュー"
                               Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding PageIndicator}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPageNavigationVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Grid.Column="1"
                        Style="{StaticResource PreviewToolbarBorder}"
                        Visibility="{Binding IsPageNavigationVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="30"
                                Padding="0"
                                Margin="0,0,4,0"
                                ToolTip="前のページ (Ctrl+←)"
                                Command="{Binding PreviousPageCommand}"
                                Style="{StaticResource CompactToolbarButton}">
                            <Path Width="8"
                                  Height="12"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M8 2 L2 7 L8 12"
                                  Stroke="{DynamicResource SecondaryButtonForegroundBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Button>
                        <TextBox MinWidth="{Binding PageNumberInputMinWidth}"
                                 MaxWidth="140"
                                 Style="{StaticResource CompactTextBox}"
                                 Text="{Binding PageNumber, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="ページ番号を入力して Enter"
                                 HorizontalContentAlignment="Right"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                 behaviors:InvokeCommandBehavior.EnterKeyCommand="{Binding GoToPageCommand}" />
                        <TextBlock Text="/"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding PageCount}"
                                   MinWidth="{Binding PageCountDisplayMinWidth}"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MutedText}" />
                        <Button Width="30"
                                Padding="0"
                                Margin="4,0,0,0"
                                ToolTip="次のページ (Ctrl+→)"
                                Command="{Binding NextPageCommand}"
                                Style="{StaticResource CompactToolbarButton}">
                            <Path Width="8"
                                  Height="12"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M2 2 L8 7 L2 12"
                                  Stroke="{DynamicResource SecondaryButtonForegroundBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource PreviewAreaBackgroundBrush}"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource PreviewAreaBorderBrush}"
                    Margin="0,14,0,0"
                    Padding="12">
                <Grid VerticalAlignment="Stretch">
                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PreviewImage}" Value="{x:Null}" />
                                            <Condition Binding="{Binding IsBusy}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Width="48"
                              Height="48"
                              Margin="0,0,0,14"
                              HorizontalAlignment="Center"
                              Stretch="Uniform"
                              Fill="{DynamicResource MutedForegroundBrush}"
                              Opacity="0.7"
                              Data="M6 2 L14 2 L20 8 L20 22 L6 22 Z M14 2 L14 8 L20 8" />
                        <TextBlock Text="プレビュー画像がここに表示されます"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock Text="ファイルを選択またはドラッグ&amp;ドロップすると自動で表示されます"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource HintText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Right"
                       Text="{Binding PageNumberValidationMessage}"
                       Style="{StaticResource ValidationMessage}"
                       MaxWidth="320"
                       Visibility="{Binding PageNumberValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
