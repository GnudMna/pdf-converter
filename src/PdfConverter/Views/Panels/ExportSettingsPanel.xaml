<UserControl x:Class="PdfConverter.Views.Panels.ExportSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:PdfConverter.Views.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="320">

    <Border Style="{StaticResource CardBorder}" Padding="18">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Rectangle Style="{StaticResource SectionHeaderAccent}" />
                <TextBlock Text="変換設定" Style="{StaticResource SectionTitle}" />
            </StackPanel>

            <StackPanel Margin="0,14,0,0">
                <TextBlock x:Name="OutputFormatLabel"
                           Text="出力形式"
                           Style="{StaticResource FieldLabel}"
                           ToolTip="JPEG / PNG / BMP から選択します。" />
                <ComboBox Margin="0,8,0,0"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding OutputImageFormatOptions}"
                          SelectedValue="{Binding OutputImageFormat}"
                          SelectedValuePath="Format"
                          DisplayMemberPath="DisplayName"
                          AutomationProperties.LabeledBy="{Binding ElementName=OutputFormatLabel}" />
            </StackPanel>

            <StackPanel Margin="0,14,0,0">
                <TextBlock x:Name="ResolutionLabel"
                           Text="出力解像度"
                           Style="{StaticResource FieldLabel}"
                           ToolTip="選択したモードに応じて、幅・高さ (px) または DPI を入力してください。" />
                <Border Style="{StaticResource SettingValueBorder}">
                    <StackPanel>
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ResolutionModeOptions}"
                                      SelectedValue="{Binding ResolutionMode}"
                                      SelectedValuePath="Mode"
                                      DisplayMemberPath="DisplayName"
                                      Width="85"
                                      AutomationProperties.LabeledBy="{Binding ElementName=ResolutionLabel}"
                                      AutomationProperties.Name="解像度モード" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding ResolutionValue}"
                                     Width="80"
                                     behaviors:TextBoxBehavior.UpdateSourceOnEnter="True"
                                     AutomationProperties.LabeledBy="{Binding ElementName=ResolutionLabel}"
                                     AutomationProperties.Name="解像度の値"
                                     AutomationProperties.HelpText="幅・高さ (px) または DPI の数値を入力してください" />
                            <TextBlock Grid.Column="3"
                                       Text="px / DPI"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedText}" />
                        </Grid>
                        <TextBlock Text="{Binding ResolutionValidationMessage}"
                                   Style="{StaticResource ValidationMessage}"
                                   Visibility="{Binding ResolutionValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="保存ページ" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource SettingValueBorder}">
                    <StackPanel>
                        <CheckBox Content="全ページを保存"
                                  IsChecked="{Binding IsAllPagesSelected}" />
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllPagesSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="ページ番号または範囲"
                                       x:Name="PageRangeLabel"
                                       Style="{StaticResource FieldLabel}"
                                       ToolTip="例: 1,3-5。8- で 8 ページ目から最終ページまで" />
                            <TextBox Margin="0,6,0,0"
                                     ToolTip="例: 1,3-5。8- で 8 ページ目から最終ページまで"
                                     Text="{Binding PageRange, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=PageRangeLabel}"
                                     AutomationProperties.HelpText="保存するページ番号または範囲。例: 1,3-5。8- で 8 ページ目から最終ページまで" />
                            <TextBlock Text="{Binding PageRangeValidationMessage}"
                                       Style="{StaticResource ValidationMessage}"
                                       Visibility="{Binding PageRangeValidationMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Margin="0,14,0,0">
                <TextBlock x:Name="JpegQualityLabel"
                           Text="JPEG 品質"
                           Style="{StaticResource FieldLabel}"
                           ToolTip="1〜100 で指定します。大きいほど高画質でファイルサイズも大きくなります。JPEG 形式のときのみ有効です。" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox Text="{Binding JpegQuality}"
                             Width="80"
                             IsEnabled="{Binding IsJpegQualitySelectable}"
                             behaviors:TextBoxBehavior.UpdateSourceOnEnter="True"
                             AutomationProperties.LabeledBy="{Binding ElementName=JpegQualityLabel}"
                             AutomationProperties.HelpText="JPEG の品質を 1〜100 の数値で入力してください" />
                    <TextBlock Text="(1〜100)"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="透明度"
                           Style="{StaticResource FieldLabel}"
                           ToolTip="オフの場合は白背景で合成します。JPEG では透明度を保持できません。" />
                <CheckBox Margin="0,8,0,0"
                          Content="透明度を保持"
                          IsChecked="{Binding PreserveTransparency}"
                          IsEnabled="{Binding IsTransparencySelectable}"
                          ToolTip="オフの場合は白背景で合成します。JPEG では透明度を保持できません。" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
