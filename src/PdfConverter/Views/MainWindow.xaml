<Window x:Class="PdfConverter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:PdfConverter.Views.Behaviors"
        xmlns:panels="clr-namespace:PdfConverter.Views.Panels"
        xmlns:views="clr-namespace:PdfConverter.Views"
        mc:Ignorable="d"
        Title="PDF Converter"
        Icon="/Assets/app.ico"
        AutomationProperties.Name="PDF Converter"
        AutomationProperties.HelpText="PDF または Word 文書のページを画像としてエクスポートします"
        Height="920"
        Width="800"
        MinHeight="600"
        MinWidth="680"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        behaviors:FileDropBehavior.IsEnabled="True">

    <Window.InputBindings>
        <KeyBinding Key="Left"
                    Modifiers="Control"
                    Command="{Binding PreviousPageCommand}" />
        <KeyBinding Key="Right"
                    Modifiers="Control"
                    Command="{Binding NextPageCommand}" />
        <KeyBinding Key="F1"
                    Command="{Binding OpenUserDocsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <panels:MainWindowHeaderPanel Grid.Row="0"
                                          DataContext="{Binding}" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"
                                      MinWidth="320"
                                      MaxWidth="480" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"
                                      MinWidth="320" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel>
                        <panels:DocumentInputPanel DataContext="{Binding}" />
                        <panels:ExportSettingsPanel DataContext="{Binding ExportSettings}" />
                    </StackPanel>
                </ScrollViewer>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource PanelGridSplitter}"
                              AutomationProperties.Name="パネル幅の調整"
                              AutomationProperties.HelpText="左右のパネル幅を変更します" />

                <panels:PreviewPanel Grid.Column="2"
                                     DataContext="{Binding Preview}" />
            </Grid>

            <panels:ActionBarPanel Grid.Row="2"
                                   DataContext="{Binding}" />

            <panels:StatusBarPanel Grid.Row="3"
                                   DataContext="{Binding Status}" />
        </Grid>

        <views:DropOverlay d:Visibility="Collapsed"
                           Visibility="{Binding IsDropOverlayVisible, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>
