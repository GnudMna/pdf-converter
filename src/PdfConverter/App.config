<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="PdfConverter.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <userSettings>
        <PdfConverter.Properties.Settings>
            <setting name="ThemeMode" serializeAs="String">
                <value>System</value>
            </setting>
            <setting name="WordToPdfBackend" serializeAs="String">
                <value>MicrosoftWord</value>
            </setting>
            <setting name="LibreOfficePath" serializeAs="String">
                <value></value>
            </setting>
            <setting name="WordToPdfPdfFormat" serializeAs="String">
                <value>Standard</value>
            </setting>
            <setting name="WordToPdfOptimizeFor" serializeAs="String">
                <value>Print</value>
            </setting>
            <setting name="WordToPdfExportBookmarks" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="WordToPdfExportComments" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="OutputImageFormat" serializeAs="String">
                <value>Png</value>
            </setting>
            <setting name="ResolutionMode" serializeAs="String">
                <value>Width</value>
            </setting>
            <setting name="ResolutionValue" serializeAs="String">
                <value>1080</value>
            </setting>
            <setting name="PreserveTransparency" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="UpgradeRequired" serializeAs="String">
                <value>True</value>
            </setting>
        </PdfConverter.Properties.Settings>
    </userSettings>
</configuration>