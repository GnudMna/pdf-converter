<?xml version="1.0" encoding="utf-8"?>
<!--
  このファイルを UpdateReleaseKey.local.props にコピーし、PDF_CONVERTER_KEY の値を設定してください。
  UpdateReleaseKey.local.props は gitignore されています（リポジトリにコミットしないでください）。

  代替: 環境変数 PDF_CONVERTER_KEY を設定してビルドしても同様に埋め込まれます。
-->
<Project>
  <PropertyGroup>
    <PdfConverterReleaseKey>YOUR_PDF_CONVERTER_KEY_HERE</PdfConverterReleaseKey>
  </PropertyGroup>
</Project>
